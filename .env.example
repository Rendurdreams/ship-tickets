DEPLOYMENT_MODE=development
PLATFORM_FEE_CENTS=0

# Provider selections used as adapters are implemented.
# AUTH_PROVIDER: mock (deterministic, no SMS, dev/test only) | supabase_phone (MVP default)
AUTH_PROVIDER=mock
PAYMENT_PROVIDER=free
STORAGE_PROVIDER=local
EMAIL_PROVIDER=console

# Standard Postgres connection; never commit a real credential.
DATABASE_URL=postgresql://ship_tickets:ship_tickets@localhost:5432/ship_tickets

# Hosted provider placeholders. Leave blank in local/free mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Supabase Auth (phone OTP, ADR 0003). Leave blank when AUTH_PROVIDER=mock.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Privy JWT-based wallet bridge (optional, ADR 0003). Off unless embedded wallets are enabled.
PRIVY_ENABLED=false
PRIVY_APP_ID=
PRIVY_APP_SECRET=
