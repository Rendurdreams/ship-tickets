DEPLOYMENT_MODE=development
PLATFORM_FEE_CENTS=0

# Provider selections used as adapters are implemented.
# AUTH_PROVIDER: mock (deterministic, no SMS, dev/test only) | supabase_phone (MVP default)
AUTH_PROVIDER=mock
PAYMENT_PROVIDER=free
STORAGE_PROVIDER=local
EMAIL_PROVIDER=console

# Restricted non-owner runtime login; never use the table owner in production.
DATABASE_URL=postgresql://ship_tickets_runtime:***@localhost:5432/ship_tickets
# Direct admin/session URL for migrations and one-time runtime-role provisioning.
# Local development may omit it and let migrations fall back to DATABASE_URL.
DATABASE_MIGRATION_URL=
# Existing dedicated runtime login; it must not belong to any PostgreSQL roles.
DATABASE_RUNTIME_ROLE=ship_tickets_runtime
# Serverless-safe defaults for Supavisor transaction mode.
DATABASE_MAX_CONNECTIONS=1
DATABASE_PREPARE_STATEMENTS=false

# Hosted provider placeholders. Leave blank in local/free mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Supabase Auth (phone OTP, ADR 0003). Leave blank when AUTH_PROVIDER=mock.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Privy JWT-based wallet bridge (optional, ADR 0003). Off unless embedded wallets are enabled.
PRIVY_ENABLED=false
PRIVY_APP_ID=
PRIVY_APP_SECRET=
